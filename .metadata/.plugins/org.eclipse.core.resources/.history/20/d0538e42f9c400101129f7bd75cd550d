package String;

/* Write a program to find the length of the string without using inbuilt function length */

public class p9 {
	public static void main(String[] args) {
		String s = "Java";
		char[] ch = s.toCharArray();
		int length = 0;
		
		for (ch lv:ch) {
			length++;
		}
		System.out.println("Length = "+length);
	}

}
